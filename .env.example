# Copy to .env and adjust. Never commit .env.
FLAKEHUNTER_PROVIDER=ollama
FLAKEHUNTER_BASE_URL=http://localhost:11434/v1
FLAKEHUNTER_MODEL=llama3.2:3b
# Any other OpenAI-compatible server (llama.cpp's llama-server, vLLM, LM Studio...):
# FLAKEHUNTER_PROVIDER=openai-compatible
# FLAKEHUNTER_BASE_URL=http://127.0.0.1:8080/v1
# FLAKEHUNTER_API_KEY=   # only if your server needs one. Never commit a real key.
